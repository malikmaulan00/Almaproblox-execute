    Instance.new("UICorner", depthBar).CornerRadius = UDim.new(1, 0)

    local depthFill = Instance.new("Frame")
    depthFill.Size = UDim2.new(CONFIG.MaxDepth / 15, 0, 1, 0)
    depthFill.BackgroundColor3 = CONFIG.ThemeColor
    depthFill.BorderSizePixel = 0
    depthFill.Parent = depthBar
    Instance.new("UICorner", depthFill).CornerRadius = UDim.new(1, 0)

    local depthBtn = Instance.new("TextButton")
    depthBtn.Size = UDim2.new(1, -20, 0, 20)
    depthBtn.Position = UDim2.new(0, 10, 0, 24)
    depthBtn.BackgroundTransparency = 1
    depthBtn.Text = ""
    depthBtn.Parent = depthRow
    depthBtn.MouseButton1Click:Connect(function()
        local pos = UserInputService:GetMouseLocation().X
        local abs = depthBar.AbsolutePosition.X
        local size = depthBar.AbsoluteSize.X
        local pct = math.clamp((pos - abs) / size, 0, 1)
        CONFIG.MaxDepth = math.floor(pct * 15) + 1
        depthFill.Size = UDim2.new(pct, 0, 1, 0)
        depthLbl.Text = "Max Depth: " .. CONFIG.MaxDepth
    end)

    -- ========== SHORTCUTS ==========
    UserInputService.InputBegan:Connect(function(input, gp)
        if gp then return end
        if input.KeyCode == Enum.KeyCode.H and UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then
            window.Visible = not window.Visible
        elseif input.KeyCode == Enum.KeyCode.S and UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then
            startCopy("all")
        elseif input.KeyCode == Enum.KeyCode.Escape then
            if activeTab ~= "MAIN" then switchTab("MAIN") end
        end
    end)

    switchTab("MAIN")
    initToasts(mainGui)

    window.BackgroundTransparency = 1
    TweenService:Create(window, TweenInfo.new(0.3), { BackgroundTransparency = 0.05 }):Play()

    toast("READY (STEALTH)", "Executed at " .. os.date("%H:%M:%S"), CONFIG.ThemeColor)
    addConsoleLine(string.format("[%s] [INFO] v3.3 Polished initialized", os.date("%H:%M:%S")))
    addConsoleLine(string.format("[%s] [INFO] Executor: %s", os.date("%H:%M:%S"), executorName))
    addConsoleLine(string.format("[%s] [INFO] Anti-Cheat: %s (%s)",
        os.date("%H:%M:%S"), AC_DETECTED.name, AC_DETECTED.risk))
    if AC_DETECTED.detected then
        addConsoleLine(string.format("[%s] [WARN] Use SAFE COPY in this server",
            os.date("%H:%M:%S")), CONFIG.WarnColor)
    end

    refs.window = window
end

