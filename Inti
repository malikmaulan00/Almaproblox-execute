-- ============================================
-- SAVE INSTANCE LOADER
-- ============================================
local function getSaveInstance()
    local sources = {
        "https://raw.githubusercontent.com/luau/UniversalSynSaveInstance/main/saveinstance.luau",
    }
    for _, url in ipairs(sources) do
        local ok, fn = pcall(function()
            return loadstring(game:HttpGet(url, true))()
        end)
        if ok and fn then
            log("ok", "saveinstance loaded")
            return fn
        end
    end
    return nil
end

-- ============================================
-- SERIALIZER
-- ============================================
local function serializeProperty(prop)
    local ok, val = pcall(function() return prop end)
    if not ok then return nil end
    local t = typeof(val)
    if t == "Vector3" then return {Type="Vector3", X=val.X, Y=val.Y, Z=val.Z} end
    if t == "CFrame" then return {Type="CFrame", Components={val:GetComponents()}} end
    if t == "Color3" then return {Type="Color3", R=val.R, G=val.G, B=val.B} end
    if t == "UDim2" then return {Type="UDim2", XS=val.X.Scale, XO=val.X.Offset, YS=val.Y.Scale, YO=val.Y.Offset} end
    if t == "BrickColor" then return {Type="BrickColor", Number=val.Number} end
    if t == "EnumItem" then return {Type="Enum", Value=tostring(val)} end
    if t == "number" or t == "string" or t == "boolean" then return val end
    if t == "Instance" then return val:GetFullName() end
    return tostring(val)
end

local function dumpInstance(inst, depth, maxDepth, counter)
    depth = depth or 0
    maxDepth = maxDepth or CONFIG.MaxDepth
    if depth > maxDepth then return nil end
    counter.n = counter.n + 1
    local data = { ClassName = inst.ClassName, Name = inst.Name, Children = {} }
    local propsToSave = {}
    pcall(function()
        for _, prop in ipairs({"Position","Size","CFrame","Color","BrickColor",
            "Material","Transparency","CanCollide","Anchored","Shape",
            "Text","TextColor3","BackgroundColor3","Ambient","Brightness",
            "ClockTime","FogEnd","FogStart","Value","MeshId",
            "TextureID","SoundId","Image","Frame","Face"}) do
            local ok, val = pcall(function() return inst[prop] end)
            if ok and val ~= nil then
                local ser = serializeProperty(val)
                if ser ~= nil then propsToSave[prop] = ser end
            end
        end
    end)
    data.Properties = propsToSave
    for _, child in ipairs(inst:GetChildren()) do
        local ok, childData = pcall(dumpInstance, child, depth + 1, maxDepth, counter)
        if ok and childData then table.insert(data.Children, childData) end
    end
    return data
end

-- ============================================
-- COPY FUNCTION
-- ============================================
function startCopy(mode)
    if SAVE_IN_PROGRESS then
        toast("Busy", "Copy already in progress", CONFIG.WarnColor)
        return
    end
    SAVE_IN_PROGRESS = true
    local startTime = os.clock()
    updateStatus("Initializing copy...", CONFIG.WarnColor)
    log("info", "Copy started: " .. mode)

    task.spawn(function()
        task.wait(0.3)
        if not API.writefile then
            updateStatus("ERROR: writefile not supported", CONFIG.DangerColor)
            toast("Error", "Executor doesn't support writefile()", CONFIG.DangerColor, 4)
            SAVE_IN_PROGRESS = false
            return
        end
        if API.makefolder then pcall(function() makefolder(CONFIG.SaveFolder) end) end

        local forceJson = false
        if AC_DETECTED.detected and (AC_DETECTED.risk == "HIGH" or AC_DETECTED.risk == "EXTREME") then
            forceJson = true
            updateStatus("AC detected, using JSON dump", CONFIG.WarnColor)
        end
        if CONFIG.SafeMode then
            updateStatus("SAFE mode active", CONFIG.WarnColor)
        end

        if not forceJson and not CONFIG.SafeMode then
            updateStatus("Loading save engine...", CONFIG.WarnColor)
            local si = getSaveInstance()
            if si then
                local succeeded = false
                for attempt = 1, 2 do
                    updateStatus(string.format("saveinstance (attempt %d/2)...", attempt), CONFIG.WarnColor)
                    local ok = pcall(function()
                        si({
                            SaveAll = (mode == "all"),
                            SaveTerrain = true,
                            SafeMode = false,
                            SavePlayers = false,
                            SaveObject = true,
                        })
                    end)
                    if ok then succeeded = true; break end
                    task.wait(1)
                end
                if succeeded then
                    local elapsed = os.clock() - startTime
                    updateStatus(string.format("Saved! (%.2fs)", elapsed), CONFIG.ThemeColor)
                    toast("Success", "Map saved!", CONFIG.ThemeColor, 3)
                    log("ok", "saveinstance success")
                    SAVE_IN_PROGRESS = false
                    return
                end
            end
        else
            updateStatus("Skip saveinstance (safe)", CONFIG.WarnColor)
        end

        updateStatus("Running JSON dump...", CONFIG.WarnColor)
        local services
        if mode == "all" then
            services = {
                Workspace, game:GetService("Lighting"),
                game:GetService("ReplicatedStorage"),
                game:GetService("StarterGui"),
                game:GetService("StarterPlayer"),
                game:GetService("SoundService"),
            }
        else
            services = { Workspace }
        end

        local result = {}
        local counter = {n = 0}
        for i, svc in ipairs(services) do
            updateStatus(string.format("Dumping %s (%d/%d)...", svc.Name, i, #services), CONFIG.WarnColor)
            local ok, data = pcall(dumpInstance, svc, 0, CONFIG.MaxDepth, counter)
            if ok and data then table.insert(result, data) end
            task.wait(0.1)
        end

        updateStatus(string.format("Collected %d instances", counter.n), CONFIG.WarnColor)
        task.wait(0.2)
        updateStatus("Encoding JSON...", CONFIG.WarnColor)
        local jsonData = HttpService:JSONEncode(result)
        local fileName = CONFIG.SaveFolder .. "/map_" .. mode .. "_" .. os.date("%Y%m%d_%H%M%S") .. ".json"
        local ok, err = pcall(function() writefile(fileName, jsonData) end)

        if ok then
            local elapsed = os.clock() - startTime
            local size = #jsonData
            updateStatus(string.format("DONE %.2fs, %s", elapsed, formatBytes(size)), CONFIG.ThemeColor)
            toast("Success", string.format("Saved! %s", formatBytes(size)), CONFIG.ThemeColor, 4)
            log("ok", "JSON save: " .. fileName)
        else
            updateStatus("FAILED: " .. tostring(err), CONFIG.DangerColor)
            toast("Error", "Save failed", CONFIG.DangerColor, 4)
        end
        SAVE_IN_PROGRESS = false
    end)
end

