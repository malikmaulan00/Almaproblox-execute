local openMainUI

local function runLoading()
    local gui, barFill, percentLabel, logLabel, cleanup = createLoadingScreen()
    local logs = {
        "Initializing...",
        "Scanning environment...",
        "Checking anti-cheat...",
        "Loading config...",
        "Ready!"
    }

    local progress = 0
    local lastIdx = 1
    local conn
    conn = RunService.Heartbeat:Connect(function(dt)
        progress = math.min(progress + dt * (100 / CONFIG.LoadingDuration), 100)
        barFill.Size = UDim2.new(progress/100, 0, 1, 0)
        percentLabel.Text = string.format("%.0f%%", progress)

        local idx = math.min(math.floor(progress / 20) + 1, #logs)
        if idx ~= lastIdx then
            lastIdx = idx
            logLabel.Text = "> " .. logs[idx]
        end

        if progress >= 100 then
            conn:Disconnect()
            task.wait(0.4)
            cleanup()
            gui:Destroy()
            if openMainUI then openMainUI() else warn("[MAP COPIER] openMainUI nil!") end
        end
    end)
end

