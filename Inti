local LogBuffer = {}
local function log(level, msg)
    local entry = string.format("[%s] [%s] %s",
        os.date("%H:%M:%S"), level:upper(), msg)
    table.insert(LogBuffer, entry)
    if #LogBuffer > 500 then table.remove(LogBuffer, 1) end
    if CONFIG.LogToFile and API.writefile then
        pcall(function()
            if API.makefolder and (not API.isfolder or not isfolder(CONFIG.SaveFolder)) then
                makefolder(CONFIG.SaveFolder)
            end
            local existing = (API.readfile and API.isfile and isfile(CONFIG.SaveFolder .. "/log.txt"))
                and readfile(CONFIG.SaveFolder .. "/log.txt") or ""
            writefile(CONFIG.SaveFolder .. "/log.txt", existing .. entry .. "\n")
        end)
    end
end

