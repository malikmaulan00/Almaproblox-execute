-- MATRIX RAIN
-- ============================================
local function createMatrixRain(parent)
    local f = Instance.new("Frame")
    f.Size = UDim2.new(1, 0, 1, 0)
    f.BackgroundTransparency = 1
    f.ZIndex = 0
    f.ClipsDescendants = true
    f.Parent = parent

    local chars = {"0","1","ア","イ","ウ","エ","オ","カ","キ"}
    local columns = {}
    local colCount = math.floor(300 / 14)

    for i = 1, colCount do
        local col = Instance.new("TextLabel")
        col.Size = UDim2.new(0, 12, 1, 0)
        col.Position = UDim2.new(0, (i-1) * 14, 0, -math.random(100, 800))
        col.BackgroundTransparency = 1
        col.TextColor3 = CONFIG.ThemeColor
        col.TextTransparency = 0.6
        col.Font = CONFIG.Font
        col.TextSize = 12
        col.TextXAlignment = Enum.TextXAlignment.Center
        col.TextYAlignment = Enum.TextYAlignment.Top
        col.ZIndex = 0
        col.Parent = f

        local str = ""
        for _ = 1, 40 do
            str = str .. chars[math.random(1, #chars)] .. "\n"
        end
        col.Text = str

        table.insert(columns, {
            obj = col,
            speed = math.random(50, 200) / 100,
            resetY = math.random(-1000, -100),
        })
    end

    local conn = RunService.Heartbeat:Connect(function()
        for _, c in ipairs(columns) do
            if c.obj and c.obj.Parent then
                local pos = c.obj.Position
                local newY = pos.Y.Offset + c.speed * 2
                if newY > 500 then newY = c.resetY end
                c.obj.Position = UDim2.new(0, pos.X.Offset, 0, newY)
            end
        end
    end)

    return f, conn
end

