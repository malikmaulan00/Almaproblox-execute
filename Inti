local AC_DETECTED = {
    name = "None", detected = false, risk = "LOW",
    allowStreamingBypass = false, allowSaveInstance = true,
}

local AC_SIGNATURES = {
    { name = "Adonis",      patterns = {"adonis", "adonis_", "adonisloader"},              risk = "HIGH" },
    { name = "Kohl's",      patterns = {"kohl", "kohlsadmin", "kohl_admin"},               risk = "HIGH" },
    { name = "HD Admin",    patterns = {"hdadmin", "hd_admin", "hd admin"},                risk = "MEDIUM" },
    { name = "Cmdr",        patterns = {"cmdr", "cmdr_"},                                  risk = "MEDIUM" },
    { name = "Basic Admin", patterns = {"basicadmin", "basic_admin"},                      risk = "HIGH" },
    { name = "Kaka Admin",  patterns = {"kaka", "kaka_admin"},                             risk = "MEDIUM" },
    { name = "Nexus",       patterns = {"nexus", "nexus_"},                                risk = "MEDIUM" },
    { name = "AntiCheat",   patterns = {"anti_exploit", "anticheat", "anti_cheat"},        risk = "HIGH" },
    { name = "Byfron",      patterns = {"byfron", "hyperion"},                             risk = "EXTREME" },
}

local function detectAntiCheat()
    local found = {}
    local scanRoots = {
        game:GetService("ServerScriptService"),
        game:GetService("ServerStorage"),
        game:GetService("ReplicatedStorage"),
        game:GetService("StarterPlayer"),
        game:GetService("Workspace"),
    }
    for _, root in ipairs(scanRoots) do
        if root then
            pcall(function()
                for _, obj in ipairs(root:GetDescendants()) do
                    local lower = obj.Name:lower()
                    for _, sig in ipairs(AC_SIGNATURES) do
                        for _, pat in ipairs(sig.patterns) do
                            if lower:find(pat, 1, true) then
                                if not found[sig.name] then found[sig.name] = sig.risk end
                                break
                            end
                        end
                    end
                    if #found >= 3 then break end
                end
            end)
        end
    end
    for name, risk in pairs(found) do
        AC_DETECTED.name = name
        AC_DETECTED.detected = true
        AC_DETECTED.risk = risk
        break
    end
    if AC_DETECTED.risk == "EXTREME" then
        AC_DETECTED.allowStreamingBypass = false
        AC_DETECTED.allowSaveInstance = false
        CONFIG.SafeMode = true
        CONFIG.MaxDepth = 4
    elseif AC_DETECTED.risk == "HIGH" then
        AC_DETECTED.allowStreamingBypass = false
        AC_DETECTED.allowSaveInstance = true
        CONFIG.SafeMode = true
        CONFIG.MaxDepth = 5
    end
    return AC_DETECTED
end

